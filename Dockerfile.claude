FROM ubuntu:22.04

ARG TZ=UTC
ENV TZ="$TZ"
ARG GIT_DELTA_VERSION=0.18.2

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget ca-certificates \
    ripgrep python3\
    less git procps sudo fzf zsh man-db unzip gnupg2 gh \
    iproute2 dnsutils jq nano vim \
    libssl-dev pkg-config tmux \
    clang libclang-dev protobuf-compiler \
    file make \
    iptables libcap2-bin \
    openssh-client \
    supervisor \
    locales \
    && locale-gen en_US.UTF-8 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Install kubectl
RUN curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" && \
    install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl && \
    rm kubectl

# Install krew (kubectl plugin manager) and plugins: ctx, ns
RUN set -x; cd "$(mktemp -d)" && \
    OS="$(uname | tr '[:upper:]' '[:lower:]')" && \
    ARCH="$(uname -m | sed -e 's/x86_64/amd64/' -e 's/\(arm\)\(64\)\?.*/\1\2/' -e 's/aarch64$/arm64/')" && \
    KREW="krew-${OS}_${ARCH}" && \
    curl -fsSLO "https://github.com/kubernetes-sigs/krew/releases/latest/download/${KREW}.tar.gz" && \
    tar zxvf "${KREW}.tar.gz" && \
    ./"${KREW}" install krew && \
    /root/.krew/bin/kubectl-krew install ctx ns

# Install ArgoCD CLI
RUN curl -sSL -o /usr/local/bin/argocd https://github.com/argoproj/argo-cd/releases/latest/download/argocd-linux-amd64 && \
    chmod +x /usr/local/bin/argocd

# Install AWS CLI v2
RUN ARCH=$(uname -m) && \
    curl "https://awscli.amazonaws.com/awscli-exe-linux-${ARCH}.zip" -o "awscliv2.zip" && \
    unzip awscliv2.zip && \
    ./aws/install && \
    rm -rf aws awscliv2.zip

# Install Node.js 22 from NodeSource (Clean way, no 'node' user created)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# install context-mode globally
RUN npm install -g context-mode

# this installs uv and adds it to the path
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"
# install patch-file-mcp
RUN uv tool install patch-file-mcp

WORKDIR /root

# Git Delta (Architecture Aware)
RUN ARCH=$(dpkg --print-architecture) && \
    wget "https://github.com/dandavison/delta/releases/download/${GIT_DELTA_VERSION}/git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
    dpkg -i "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb" && \
    rm "git-delta_${GIT_DELTA_VERSION}_${ARCH}.deb"

# install claude
# 2.1.2 was 4.6 era
# 2.1.116 was 4.7 after the patch
# 2.1.197 is the june 30, 2026 release
RUN curl -fsSL https://claude.ai/install.sh | bash -s 2.1.197

# install zsh
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
RUN echo 'export ZSH="/root/.oh-my-zsh"' > /root/.zshrc && \
    echo 'plugins=(git fzf)' >> /root/.zshrc && \
    echo 'source $ZSH/oh-my-zsh.sh' >> /root/.zshrc

# Toolchains: CMake
RUN ARCH=$(uname -m) && \
    wget -q https://github.com/Kitware/CMake/releases/download/v3.31.1/cmake-3.31.1-linux-${ARCH}.tar.gz && \
    tar -xvf cmake-3.31.1-linux-${ARCH}.tar.gz --strip-components=1 -C /usr/local && \
    rm cmake-3.31.1-linux-${ARCH}.tar.gz

# Build and install mold
RUN wget -q https://github.com/rui314/mold/releases/download/v2.41.0/mold-2.41.0-x86_64-linux.tar.gz && \
    tar -xzf mold-2.41.0-x86_64-linux.tar.gz --strip-components=1 -C /usr/local && \
    rm mold-2.41.0-x86_64-linux.tar.gz

ENV PATH=/usr/local/cargo/bin:/root/.local/bin:/root/.krew/bin:$PATH

# Ensure the cargo path is added to the global bash/zsh configs for all shells
RUN echo 'export PATH="/usr/local/cargo/bin:$PATH"' >> /etc/environment && \
    echo 'export PATH="/usr/local/cargo/bin:$PATH"' >> /root/.bashrc && \
    echo 'export PATH="/usr/local/cargo/bin:$PATH"' >> /root/.zshrc

# Convenience alias for unattended claude
RUN echo "alias run='claude --dangerously-skip-permissions'" >> /root/.bashrc && \
    echo "alias run='claude --dangerously-skip-permissions'" >> /root/.zshrc

RUN echo "alias run2='claude --agent opus-agent --dangerously-skip-permissions'" >> /root/.bashrc && \
    echo "alias run2='claude --agent opus-agent --dangerously-skip-permissions'" >> /root/.zshrc

RUN echo "alias run3='claude --agent sonnet-agent --dangerously-skip-permissions'" >> /root/.bashrc && \
    echo "alias run3='claude --agent sonnet-agent --dangerously-skip-permissions'" >> /root/.zshrc

# Tells Claude Code it is running in a secure, isolated sandbox
ENV IS_SANDBOX=1
# disable certain prompts that do bad things
ENV CLAUDE_CODE_TEAM_ONBOARDING=0
ENV DISABLE_TELEMETRY=1
ENV DISABLE_AUTOUPDATER=1
ENV ENABLE_TOOL_SEARCH=1

# user must install the claude rust analyzer plugins when claude is already logged in. mounting the .claude directory on volume will make this persist

# Setup workspace and directories
RUN mkdir -p /root/rust_target /root/.claude /commandhistory && \
    touch /commandhistory/.bash_history

COPY ra_tool.py /bin/ra_tool.py
RUN chmod +x /bin/ra_tool.py
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY narsil_client.py /bin/narsil_client.py
RUN chmod +x /bin/narsil_client.py

RUN uv pip install --system typer typing_extensions click

WORKDIR /root

COPY scripts/agent /bin/agent
RUN chmod +x /bin/agent

RUN echo "alias narsil='/bin/narsil_client.py'" >> /root/.bashrc

COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

WORKDIR /root
USER root
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
