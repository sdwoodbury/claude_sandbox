#!/bin/bash
set -euo pipefail

# Configuration
IMAGE_NAME="claude:latest"
CODE_DIR="$(pwd -P)"
CLAUDE_DATA="claude_data_vol"
AGENT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)/../agent_config"

# Define Base Mounts
DOCKER_FLAGS=(
    "-it" "--rm"
#    "--name" "claude_sandbox"
    "--cap-add=NET_ADMIN"
    "--env" "DEVCONTAINER=true"
    "--env" "TERM=xterm-256color"
    # make sure that rust analzyer has the same paths on the container
    "-v" "${CODE_DIR}:"${CODE_DIR}
    "-w" "${CODE_DIR}"
    "-v" "/tmp/lspmux.sock:/tmp/lspmux.sock"
    # claude persistence
    "-v" "${CLAUDE_DATA}:/root/.claude"
    "-v" "${HOME}/.claude.json:/root/.claude.json"
    "-v" "${HOME}/.gitconfig.claude:/root/.gitconfig:ro"
    # for the claude agent/subagent orchestration
    "-v" "${AGENT_DIR}/CLAUDE.md:/root/.claude/CLAUDE.md:ro"
    "-v" "${AGENT_DIR}/log-scout.md:/root/.claude/agents/log-scout.md:ro"
    "-v" "${AGENT_DIR}/rust-explorer.md:/root/.claude/agents/rust-explorer.md:ro"
    "-v" "${AGENT_DIR}/orchestrator.md:/root/.claude/agents/orchestrator.md:ro"
    "-v" "${AGENT_DIR}/human-loop.md:/root/.claude/agents/human-loop.md:ro"
    "-v" "${AGENT_DIR}/skills:/root/.claude/skills:ro"
)

# Flag Parsing
ENABLE_GIT_WRITE=false
ENABLE_CARGO=false
CARGO_CACHE_TARGET="/root/.cargo"

for arg in "$@"; do
    case "$arg" in
        -g)
            echo "Git Write Access Enabled (Agents can commit)"
            DOCKER_FLAGS+=("-v" "${CODE_DIR}/.git:${CODE_DIR}/.git:rw")
            ENABLE_GIT_WRITE=true
            ;;
        -c)
            echo "Cargo + Rustup Mounts Enabled"
            ENABLE_CARGO=true
            CARGO_CACHE_TARGET="/usr/local/cargo"
            ;;
        -ka)
            echo "Kubernetes + AWS Access Enabled (for EKS)"
            DOCKER_FLAGS+=("--env" "ENABLE_KA=true")
            [ -d "${HOME}/.kube" ] && DOCKER_FLAGS+=("-v" "${HOME}/.kube:/root/.kube:rw") || echo "Warning: ~/.kube not found, skipping kubectl mount"
            [ -d "${HOME}/.aws" ] && DOCKER_FLAGS+=("-v" "${HOME}/.aws:/root/.aws:rw") || echo "Warning: ~/.aws not found, skipping AWS mount"
            ;;
        -h|--help)
            echo "Usage: claude_up [OPTIONS]"
            echo "  -g     Enable git write access (removes :ro from .git)"
            echo "  -c     Enable cargo + rustup mounts"
            echo "  -ka    Enable kubectl + AWS (for EKS clusters)"
            echo "  -h     Show this help message"
            exit 0
            ;;
    esac
done

if [ "$ENABLE_GIT_WRITE" = false ]; then
    DOCKER_FLAGS+=("-v" "${CODE_DIR}/.git:${CODE_DIR}.git:ro")
fi

# Always mount cargo caches (registry + git) for reasoning about source code
if [ -d "Cargo.toml" ]; then
    DOCKER_FLAGS+=("-v" "${HOME}/.cargo/registry:${CARGO_CACHE_TARGET}/registry")
    DOCKER_FLAGS+=("-v" "${HOME}/.cargo/git:${CARGO_CACHE_TARGET}/git")
fi

if [ "$ENABLE_CARGO" = true ]; then
    if [ -d "${HOME}/.cargo" ]; then
        # Use host-installed cargo and config inside the container.
        DOCKER_FLAGS+=("-v" "${HOME}/.cargo:/usr/local/cargo:ro")
        DOCKER_FLAGS+=("--env" "CARGO_HOME=/usr/local/cargo")
    else
        echo "Warning: ~/.cargo not found, skipping cargo mount"
    fi

    if [ -d "${HOME}/.rustup" ]; then
        # Prevent rustup from downloading toolchains by reusing host toolchains.
        DOCKER_FLAGS+=("-v" "${HOME}/.rustup:/usr/local/rustup:ro")
        DOCKER_FLAGS+=("--env" "RUSTUP_HOME=/usr/local/rustup")
    else
        echo "Warning: ~/.rustup not found, rustup may download toolchains"
    fi
fi

# Launch Container
echo "Launching Claude..."
docker run "${DOCKER_FLAGS[@]}" "$IMAGE_NAME"
